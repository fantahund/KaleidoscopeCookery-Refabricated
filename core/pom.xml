<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.emrion</groupId>
        <artifactId>Kaleidoscope</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>KaleidoscopeCookery</artifactId>
    <packaging>jar</packaging>

    <name>KaleidoscopeCookery</name>
    <description>Kochstationen, Gerichte und Pflanzen nach Kaleidoscope Cookery – mit Display-Entities und Server-Resourcepack</description>

    <properties>
        <pack.output>${project.build.directory}/generated-resources/pack</pack.output>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <!-- Validate and zip the resource pack and print its SHA1 (tools/build_pack.py). The zip ends up in the jar. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>build-resourcepack</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>python3</executable>
                            <arguments>
                                <argument>-I</argument>
                                <argument>${project.basedir}/../tools/build_pack.py</argument>
                                <argument>--out</argument>
                                <argument>${pack.output}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>paper-plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>paper-plugin.yml</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>${pack.output}</directory>
                <filtering>false</filtering>
            </resource>
            <resource>
                <!-- Licenses of this project (code and assets) -->
                <directory>${project.basedir}/..</directory>
                <includes>
                    <include>LICENSE-CODE</include>
                    <include>LICENSE-ASSETS</include>
                </includes>
                <targetPath>licenses</targetPath>
            </resource>
        </resources>
    </build>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
        </dependency>
        <dependency>
            <groupId>de.iani.cubeside</groupId>
            <artifactId>CubesideUtilsBukkit</artifactId>
        </dependency>
        <dependency>
            <groupId>de.cubeside.nmsutils</groupId>
            <artifactId>nmsutils-plugin</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>
</project>
