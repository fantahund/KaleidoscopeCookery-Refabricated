{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "fixed",
        "model": {
          "type": "minecraft:model",
          "model": "kaleidoscope_cookery:item/fruit_basket__fixed"
        }
      },
      {
        "when": "ground",
        "model": {
          "type": "minecraft:model",
          "model": "kaleidoscope_cookery:item/fruit_basket__ground"
        }
      },
      {
        "when": "gui",
        "model": {
          "type": "minecraft:model",
          "model": "kaleidoscope_cookery:item/fruit_basket__gui"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "kaleidoscope_cookery:item/fruit_basket__base"
    }
  }
}
